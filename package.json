{
  "name": "http-up",
  "version": "3.3.3",
  "description": "Simple share folder via http with upload",
  "type": "module",
  "main": "./bin/http-up",
  "bin": {
    "http-up": "bin/http-up"
  },
  "scripts": {
    "start": "node ./bin/http-up",
