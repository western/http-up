  },
  "directories": {
    "lib": "lib",
    "bin": "bin",
    "view": "view",
    "assets": "assets",
    "model": "model"
  },
  "files": [
    "lib",
    "bin",
    "view",
    "assets",
    "model",
    "README.md"
  ],
