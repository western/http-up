

<div class="container">

    <div class="row " style="padding:50px 0;">
        
        <div class="col text-truncate">
            <h2>
                <a href="/" title="Home"><i class="bi bi-house-door"></i></a>
                &nbsp;
                <a href="javascript:history.back();" title="Return back"><i class="bi bi-arrow-left-square"></i></a>
                &nbsp;
                <i class="bi bi-search"></i>
                Search
            </h2>
        </div>
        
        
        <div class="col" style="padding:20px 0 0 0;">

            <div class="col-12">
                
                <div class="input-group input-group-lg mb-3">
                    
                    <div class="input-group mb-3">
                        <input type="text" class="form-control" placeholder="" aria-label="" id="search_input" value="{{search_string}}" >
                        <button class="btn btn-outline-secondary" type="button" id="search_button">Search</button>
                    </div>
                    
                </div>
                
            </div>
            
            
            
        </div>
        
        
        
        
        
        
        <table class="table file-table table-hover ">
            <thead>
                <tr>
                    
                    <th  ></th>
                    <th></th>
                    <th>ext</th>
                    <th>size</th>
                    <th>modified</th>
                    
                </tr>
            </thead>
            <tbody>


                {{#each result_list}}
                    
                    <tr>
                        <th  >
                            <a href="{{only_fold}}">{{{only_fold_html}}}</a>
                        </th>
                        <td>
                            <a href="{{full_path}}">{{{filename_html}}}</a>
                        </td>
                        <td>{{ext}}</td>
                        <td>{{SizeHuman}}</td>
                        <td>{{modified}}</td>
                        
                    </tr>

                {{/each}}

            </tbody>
        </table>
        
        
        
    </div>

</div>

